{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "one-click-deploy",
  "main": "worker.js",

  "compatibility_date": "2026-09-21",

  "workers_dev": true,

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0fe31bd377ec4aa2bbe287e54d5a4873"
    }
  ],

  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
