{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "one-click-deploy",
  "main": "worker.js",

  "compatibility_date": "2026-09-21",

  // workers_dev: true publishes to <name>.<account>.workers.dev for quick testing.
  // For production, set up a custom domain in the Cloudflare dashboard and set
  // workers_dev to false (or remove it).
  "workers_dev": true,

  // KV namespace for deploy-job state and template cache.
  // SETUP: Run  wrangler kv namespace create KV
  // then replace the "id" value below with the ID printed by that command.
  // For local dev with  wrangler dev, add a "preview_id" entry too.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0fe31bd377ec4aa2bbe287e54d5a4873"
    }
  ],

  // Optional: set a GITHUB_TOKEN secret to enable live template data from the
  // GitHub Search API.  wrangler secret put GITHUB_TOKEN
  // Without it the Worker falls back to the built-in static template list.

  // Optional: set a TYPESAFE_API_KEY to enable Jev-powered AI template
  // recommendation (/api/recommend) and deployment error classification.
  //   wrangler secret put TYPESAFE_API_KEY
  // Get a key at https://console.typesafe.ai   Without it those features are
  // disabled gracefully — /api/recommend returns 503 and error logs are plain.

  // Daily cron: invalidates the daily template cache so the Worker re-fetches
  // fresh data from the GitHub Search API on the next /api/templates request.
  // On the 1st of each month the monthly cycle key is also rotated.
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
